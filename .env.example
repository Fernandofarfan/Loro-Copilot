# ==========================================
# LORO COPILOT — Environment Variables
# ==========================================

# Deepgram — Transcripción de audio en streaming (console.deepgram.com)
DEEPGRAM_API_KEY=

# LLM Providers (configurar al menos uno)
# ------------------------------------------
# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenCode / OpenRouter (OpenAI-compatible)
# OPENCODE_API_KEY=
# OPENCODE_MODEL=deepseek/deepseek-chat
# LLM_PROVIDER=opencode

# Anthropic Claude (console.anthropic.com)
# ANTHROPIC_API_KEY=

# OpenAI GPT (platform.openai.com)
# OPENAI_API_KEY=

# Dominio base canónico (default: https://loro-copilot.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://loro-copilot.vercel.app

# Kill Switch de Capacidad (opcional)
# Con "1", las APIs devuelven 503 HTTP para proteger de picos de gasto inesperados.
# CAPACITY_CLOSED=1

# Formulario de Lista de Espera (opcional)
# GFORM_ACTION=https://docs.google.com/forms/d/e/XXXX/formResponse
# GFORM_EMAIL_ENTRY=entry.1234567890

# Analytics (PostHog - opcional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
